@{
    ViewBag.Title = "Employee List";
}

<div class="container">
    <h2>Employee List</h2>
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Department</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var employee in Model)
            {
                <tr>
                    <td>@employee.FullName</td>
                    <td>@employee.DepartmentName</td>
                    <td>@employee.Status</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@employee.EmployeeId" class="btn btn-sm btn-warning">Edit</a>
                        <form asp-action="Delete" asp-route-id="@employee.EmployeeId" method="post" style="display: inline;">
                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this employee?');">Delete</button>
                        </form>
                    </td>
                </tr>
            }
    </table>
    <a asp-action="Add" class="btn btn-primary">Add Employee</a>
</div>
