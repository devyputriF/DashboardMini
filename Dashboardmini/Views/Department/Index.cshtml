
@{
    ViewBag.Title = "Department";
}

<div class="container">
    <h2>Departments</h2>
    <table class="table">
        <thead>
            <tr>
                <th>Department Name</th>
                <th>Total Employee</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var department in Model)
            {
                <tr>
                    <td>@department.DepartmentName</td>
                    <td>@department.CountEmployees</td>
                    <td>@department.Status</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@department.DepartmentId" class="btn btn-sm btn-warning">Edit</a>
                        <form asp-action="Delete" asp-route-id="@department.DepartmentId" method="post" style="display: inline;">
                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this department?');">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<a asp-action="Create" class="btn btn-primary">Add Department</a>


