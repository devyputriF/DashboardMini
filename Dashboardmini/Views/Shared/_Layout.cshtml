@using Dashboardmini.Enums

@{
    var role = (int)Context.Session.GetInt32("Role");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Dashboard</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Dashboardmini.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">

            <div class="container-fluid">

                <a class="navbar-brand" href="#">
                    Employee Management
                </a>

                <button class="navbar-toggler"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">

                    <ul class="navbar-nav me-auto">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Dashboard"
                               asp-action="Index">
                                Dashboard
                            </a>
                        </li>

                        @if (role == (int)UserRole.Staff)
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Profile"
                                   asp-action="Index">
                                    My Profile
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="LeaveRequest"
                                   asp-action="Index">
                                    Leave Request
                                </a>
                            </li>
                        }

                        @if (role == (int)UserRole.Manager)
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Employee"
                                   asp-action="Index">
                                    Employees
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Approval"
                                   asp-action="Index">
                                    Approval
                                </a>
                            </li>
                        }

                        @if (role == (int)UserRole.Admin)
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Employee"
                                   asp-action="Index">
                                    Employees
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Department"
                                   asp-action="Index">
                                    Department
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="User"
                                   asp-action="Index">
                                    Users
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Role"
                                   asp-action="Index">
                                    Roles
                                </a>
                            </li>
                        }

                    </ul>

                    <span class="navbar-text me-3">
                        @Context.Session.GetString("Username")
                    </span>

                    <a asp-controller="Auth"
                       asp-action="Logout"
                       class="btn btn-outline-light">
                        Logout
                    </a>

                </div>

            </div>

        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Dashboard - <a asp-area="" asp-controller="Dashboard" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
